<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>eQuantic Validation Source Generator</Title>
    <Description>Incremental source generator that produces Native AOT-friendly DI registration for eQuantic validators.</Description>
    <AssemblyTitle>eQuantic.Validation.Generator</AssemblyTitle>
    <AssemblyName>eQuantic.Validation.Generator</AssemblyName>
    <PackageId>eQuantic.Validation.Generator</PackageId>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageTags>eQuantic;Validation;SourceGenerator;Roslyn;NativeAOT;DependencyInjection</PackageTags>
    <PackageReleaseNotes>Initial incremental generator for compile-time validator DI registration.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
